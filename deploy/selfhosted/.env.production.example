# Sentra packaged deployment template.
# Copy this file to `.env` inside the unpacked bundle before starting the stack.
# Replace all placeholder secrets before exposing the stack outside local development.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=sentra
MYSQL_USER=sentra
MYSQL_PASSWORD=change-me-app-password

# API
API_PORT=8080
REDIS_URL=redis://redis:6379
MYSQL_DSN=sentra:change-me-app-password@tcp(mysql:3306)/sentra?parseTime=true
SENTRA_API_BEARER_TOKEN=change-me-api-token
# Set this when an SSO/auth proxy can inject SENTRA_ACTION_HEADER only for approved operators.
SENTRA_ACTION_TOKEN=change-me-operator-action-token
SENTRA_ACTION_HEADER=x-sentra-action-token
SENTRA_ACTION_ACTOR_HEADER=x-sentra-actor
SENTRA_REQUIRE_TENANT=true
SENTRA_DEFAULT_TENANT=primary
SENTRA_TENANT_HEADER=x-sentra-tenant
SENTRA_CORS_ORIGINS=https://sentra.example.com
SENTRA_CORS_ALLOW_CREDENTIALS=true
SENTRA_RATE_LIMIT_ENABLED=true
SENTRA_RATE_LIMIT_WINDOW_SEC=60
SENTRA_RATE_LIMIT_MAX=1200
SENTRA_TRUST_PROXY=true
SENTRA_JSON_BODY_LIMIT=1mb
SENTRA_SHUTDOWN_GRACE_SEC=10
SENTRA_AI_ENABLED=true
SENTRA_AI_URL=http://ai:8000
SENTRA_AI_TIMEOUT_SEC=3

# Controller
CONTROLLER_HTTP_PORT=8090
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
LOKI_TENANT_ID=local
TEMPO_URL=http://tempo:3200
TELEMETRY_WINDOW_SEC=60
TELEMETRY_STEP_SEC=5
TELEMETRY_POLL_INTERVAL_SEC=15
TELEMETRY_QUERY_TIMEOUT_SEC=5
RECONCILE_TIMEOUT_SEC=10
SENTRA_CONTROLLER_BEARER_TOKEN=change-me-controller-token

# Kubernetes guarded apply
KUBECTL_BIN=kubectl
KUBERNETES_APPLY_ENABLED=false
KUBERNETES_ALLOW_MUTATIONS=false
KUBERNETES_ALLOWED_CONTEXTS=
KUBERNETES_ALLOWED_CLUSTERS=
KUBERNETES_APPLY_TIMEOUT_SEC=15

# Cloud Run guarded apply
GCLOUD_BIN=gcloud
GCP_CLOUDRUN_APPLY_ENABLED=false
GCP_CLOUDRUN_ALLOW_MUTATIONS=false
GCP_CLOUDRUN_ALLOWED_PROJECTS=
GCP_CLOUDRUN_ALLOWED_REGIONS=
GCP_CLOUDRUN_APPLY_TIMEOUT_SEC=20

# Lambda guarded apply
AWS_CLI_BIN=aws
AWS_LAMBDA_APPLY_ENABLED=false
AWS_LAMBDA_ALLOW_MUTATIONS=false
AWS_LAMBDA_ALLOWED_REGIONS=
AWS_LAMBDA_ALLOWED_FUNCTIONS=
AWS_LAMBDA_APPLY_TIMEOUT_SEC=20

# Azure Container Apps guarded apply
AZURE_CLI_BIN=az
AZURE_CONTAINERAPPS_APPLY_ENABLED=false
AZURE_CONTAINERAPPS_ALLOW_MUTATIONS=false
AZURE_CONTAINERAPPS_ALLOWED_SUBSCRIPTIONS=
AZURE_CONTAINERAPPS_ALLOWED_RESOURCE_GROUPS=
AZURE_CONTAINERAPPS_APPLY_TIMEOUT_SEC=20
SATELLITE_ENABLED=false
SATELLITE_NAME=regional-satellite
SATELLITE_MODE=satellite
SATELLITE_CLOUD=
SATELLITE_REGION=
SATELLITE_CLUSTER=
SATELLITE_ENDPOINT_URL=
SATELLITE_VERSION=dev
SATELLITE_COORDINATOR_URL=
SATELLITE_COORDINATOR_TOKEN=
SATELLITE_TENANT_KEY=
SATELLITE_TENANT_HEADER=x-sentra-tenant
SATELLITE_HEARTBEAT_INTERVAL_SEC=30
SATELLITE_COORDINATOR_TIMEOUT_SEC=5
SATELLITE_TASKS_ENABLED=false
SATELLITE_TASK_POLL_INTERVAL_SEC=5
SATELLITE_TASK_LEASE_SEC=30

# Optional onboarding defaults
PROJECT_NAME=sample-project
SERVICE_NAME=sample-service
ENVIRONMENT_NAME=production
DEPLOY_TARGET_TYPE=kubernetes
