# Local development defaults for Sentra.
# Copy this file to `.env` for local use only.
# Do not commit real cloud credentials, API keys, or tokens to Git.

# MySQL
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=sentra_root
MYSQL_DATABASE=sentra
MYSQL_USER=sentra
MYSQL_PASSWORD=sentra_pass

# API
SENTRA_API_HOST_PORT=8080
SENTRA_WEB_HOST_PORT=3000
SENTRA_AI_HOST_PORT=8000
SENTRA_CONTROLLER_HOST_PORT=8090
SENTRA_PROMETHEUS_HOST_PORT=9090
SENTRA_LOKI_HOST_PORT=3100
SENTRA_TEMPO_HOST_PORT=3200
SENTRA_DEMO_WORKLOAD_HOST_PORT=18091
REDIS_HOST_PORT=6379
API_PORT=8080
REDIS_URL=redis://redis:6379
MYSQL_DSN=sentra:sentra_pass@tcp(mysql:3306)/sentra?parseTime=true
SENTRA_API_BEARER_TOKEN=
# Optional OIDC/SSO. Leave empty locally unless testing a real identity provider.
SENTRA_OIDC_ISSUER=
SENTRA_OIDC_AUDIENCE=
SENTRA_OIDC_JWKS_URL=
SENTRA_OIDC_DISCOVERY_URL=
SENTRA_OIDC_ROLES_CLAIM=roles
SENTRA_OIDC_TENANT_CLAIM=tenant
SENTRA_OIDC_TENANTS_CLAIM=tenants
SENTRA_OIDC_ACTOR_CLAIM=email
SENTRA_RBAC_ENABLED=false
SENTRA_RBAC_ACTION_TOKEN_FALLBACK=true
SENTRA_RBAC_VIEWER_ROLES=viewer,sentra:viewer
SENTRA_RBAC_OPERATOR_ROLES=operator,sentra:operator
SENTRA_RBAC_ADMIN_ROLES=admin,sentra:admin
SENTRA_STATIC_BEARER_ROLES=viewer
# Optional. When set, mutating operator routes require this value in SENTRA_ACTION_HEADER.
SENTRA_ACTION_TOKEN=
SENTRA_ACTION_HEADER=x-sentra-action-token
SENTRA_ACTION_ACTOR_HEADER=x-sentra-actor
SENTRA_REQUIRE_TENANT=false
SENTRA_DEFAULT_TENANT=default
SENTRA_TENANT_HEADER=x-sentra-tenant
SENTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTRA_CORS_ALLOW_CREDENTIALS=true
SENTRA_RATE_LIMIT_ENABLED=true
SENTRA_RATE_LIMIT_BACKEND=memory
SENTRA_RATE_LIMIT_WINDOW_SEC=60
SENTRA_RATE_LIMIT_MAX=600
SENTRA_RATE_LIMIT_REDIS_PREFIX=sentra:rate-limit
SENTRA_RATE_LIMIT_REDIS_FAIL_OPEN=false
SENTRA_TRUST_PROXY=false
SENTRA_JSON_BODY_LIMIT=1mb
SENTRA_SHUTDOWN_GRACE_SEC=10
SENTRA_AI_ENABLED=true
SENTRA_AI_URL=http://ai:8000
SENTRA_AI_TIMEOUT_SEC=3
SENTRA_AI_CANDIDATE_PROFILE_PATH=config/ai/candidate-risk-profile.json

# Controller
CONTROLLER_HTTP_PORT=8090
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
LOKI_TENANT_ID=local
TEMPO_URL=http://tempo:3200
TELEMETRY_WINDOW_SEC=60
TELEMETRY_STEP_SEC=5
TELEMETRY_POLL_INTERVAL_SEC=15
TELEMETRY_QUERY_TIMEOUT_SEC=5
RECONCILE_TIMEOUT_SEC=10
KUBECTL_BIN=kubectl
KUBERNETES_APPLY_ENABLED=false
KUBERNETES_ALLOW_MUTATIONS=false
KUBERNETES_ALLOWED_CONTEXTS=
KUBERNETES_ALLOWED_CLUSTERS=
KUBERNETES_APPLY_TIMEOUT_SEC=15
GCLOUD_BIN=gcloud
GCP_CLOUDRUN_APPLY_ENABLED=false
GCP_CLOUDRUN_ALLOW_MUTATIONS=false
GCP_CLOUDRUN_ALLOWED_PROJECTS=
GCP_CLOUDRUN_ALLOWED_REGIONS=
GCP_CLOUDRUN_APPLY_TIMEOUT_SEC=20
AWS_CLI_BIN=aws
AWS_LAMBDA_APPLY_ENABLED=false
AWS_LAMBDA_ALLOW_MUTATIONS=false
AWS_LAMBDA_ALLOWED_REGIONS=
AWS_LAMBDA_ALLOWED_FUNCTIONS=
AWS_LAMBDA_APPLY_TIMEOUT_SEC=20
AZURE_CLI_BIN=az
AZURE_CONTAINERAPPS_APPLY_ENABLED=false
AZURE_CONTAINERAPPS_ALLOW_MUTATIONS=false
AZURE_CONTAINERAPPS_ALLOWED_SUBSCRIPTIONS=
AZURE_CONTAINERAPPS_ALLOWED_RESOURCE_GROUPS=
AZURE_CONTAINERAPPS_APPLY_TIMEOUT_SEC=20
SATELLITE_ENABLED=false
SATELLITE_NAME=local-satellite
SATELLITE_MODE=satellite
SATELLITE_CLOUD=
SATELLITE_REGION=
SATELLITE_CLUSTER=
SATELLITE_ENDPOINT_URL=
SATELLITE_VERSION=dev
SATELLITE_COORDINATOR_URL=
SATELLITE_COORDINATOR_TOKEN=
SATELLITE_TENANT_KEY=
SATELLITE_TENANT_HEADER=x-sentra-tenant
SATELLITE_HEARTBEAT_INTERVAL_SEC=30
SATELLITE_COORDINATOR_TIMEOUT_SEC=5
SATELLITE_TASKS_ENABLED=false
SATELLITE_TASK_POLL_INTERVAL_SEC=5
SATELLITE_TASK_LEASE_SEC=30
SENTRA_CONTROLLER_BEARER_TOKEN=

# Local project onboarding placeholders
# Safe for local `.env`: project names, service names, environment names, and local URLs.
PROJECT_NAME=sample-project
SERVICE_NAME=sample-service
ENVIRONMENT_NAME=staging
DEPLOY_TARGET_TYPE=kubernetes

# Telemetry label placeholders used when building monitoring queries later
TELEMETRY_LABEL_PROJECT=sample-project
TELEMETRY_LABEL_SERVICE=sample-service
TELEMETRY_LABEL_ENV=staging
TELEMETRY_LABEL_VERSION=canary

# Integration placeholders
# Keep these empty locally unless you are testing a real integration.
# For shared or production environments, prefer secret managers or workload identity.
KUBE_CONTEXT=
KUBE_NAMESPACE=
AWS_ROLE_ARN=
AWS_REGION=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT_ID=
